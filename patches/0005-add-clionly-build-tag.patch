new file mode 100644
index 000000000..501e963b3
--- /dev/null
+++ b/tsc/cmd/tsc/clionly.go
@@ -0,0 +1,21 @@
+//go:build clionly
+
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+// Builds tagged clionly leave out the language server and the API, to compare
+// the size of the command line compiler alone with TypeScript 6's tsc.js.
+
+func runLSP(args []string) int {
+	fmt.Fprintln(os.Stderr, "this build has no language server (built with -tags clionly)")
+	return 1
+}
+
+func runAPI(args []string) int {
+	fmt.Fprintln(os.Stderr, "this build has no API (built with -tags clionly)")
+	return 1
+}
