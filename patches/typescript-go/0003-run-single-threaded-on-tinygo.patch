diff --git a/internal/core/singlethreaded.go b/internal/core/singlethreaded.go
new file mode 100644
index 00000000..8d0b1e8d
--- /dev/null
+++ b/internal/core/singlethreaded.go
@@ -0,0 +1,16 @@
+package core
+
+import "sync"
+
+// SingleThreadedRuntime is set by builds whose runtime cannot run goroutines in parallel.
+var SingleThreadedRuntime bool
+
+// GoOrRun starts fn on wg, or runs it before returning under SingleThreadedRuntime.
+// Only for tasks that do not wait on each other.
+func GoOrRun(wg *sync.WaitGroup, fn func()) {
+	if SingleThreadedRuntime {
+		fn()
+		return
+	}
+	wg.Go(fn)
+}
diff --git a/internal/core/singlethreaded_test.go b/internal/core/singlethreaded_test.go
new file mode 100644
index 00000000..976d35c4
--- /dev/null
+++ b/internal/core/singlethreaded_test.go
@@ -0,0 +1,33 @@
+package core
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"gotest.tools/v3/assert"
+)
+
+func TestGoOrRun(t *testing.T) {
+	t.Run("runs every function by the time Wait returns", func(t *testing.T) {
+		var wg sync.WaitGroup
+		var ran atomic.Int32
+		for range 10 {
+			GoOrRun(&wg, func() { ran.Add(1) })
+		}
+		wg.Wait()
+		assert.Equal(t, ran.Load(), int32(10))
+	})
+
+	t.Run("runs the function before returning under SingleThreadedRuntime", func(t *testing.T) {
+		saved := SingleThreadedRuntime
+		SingleThreadedRuntime = true
+		t.Cleanup(func() { SingleThreadedRuntime = saved })
+
+		var wg sync.WaitGroup
+		ran := false
+		GoOrRun(&wg, func() { ran = true })
+		assert.Assert(t, ran)
+		wg.Wait()
+	})
+}
diff --git a/internal/core/singlethreaded_tinygo.go b/internal/core/singlethreaded_tinygo.go
new file mode 100644
index 00000000..d495320f
--- /dev/null
+++ b/internal/core/singlethreaded_tinygo.go
@@ -0,0 +1,11 @@
+//go:build tinygo
+
+package core
+
+// TinyGo runs goroutines on one thread and gives each a fixed-size stack, so a
+// goroutine per file or package costs time and, on large projects, all of
+// wasm32's memory. This also covers the language server, which has no
+// --singleThreaded flag.
+func init() {
+	SingleThreadedRuntime = true
+}
